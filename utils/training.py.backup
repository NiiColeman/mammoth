    """Log parameter efficiency metrics to wandb or other loggers."""
    task_id = analysis.get('task_id', 0)
    
    log_data = {
        f'params/total_task_{task_id}': analysis['total_params'],
        f'params/trainable_task_{task_id}': analysis['trainable_params'],
